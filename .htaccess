# Efictalia - configuración Apache

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.shtml

<IfModule mod_rewrite.c>
  RewriteEngine On

  # www.efictalia.com.mx -> efictalia.com.mx (el paso a HTTPS ya lo hace el hosting)
  RewriteCond %{HTTP_HOST} ^www\.efictalia\.com\.mx$ [NC]
  RewriteRule ^ https://efictalia.com.mx%{REQUEST_URI} [R=301,L]

  # Páginas antiguas que ya no existen
  RewriteRule ^nosotros\.html$ /#quienes-somos [R=301,L,NE]
  RewriteRule ^mejora_continua\.html$ /#servicios [R=301,L,NE]
  RewriteRule ^home\.html$ / [R=301,L]

  # Carpeta de pruebas y archivos internos: no deben ser públicos
  RewriteRule ^pruebas(/|$) - [G,L]
  RewriteRule (^|/)\.git(/|$) - [F,L]
  RewriteRule ^(README\.md|error_log)$ - [F,L]
</IfModule>

# Compresión
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# Caché del navegador
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType application/pdf "access plus 1 month"
</IfModule>
